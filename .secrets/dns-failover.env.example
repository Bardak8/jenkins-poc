# Copier ce fichier en .secrets/dns-failover.env (gitignoré) et
# renseigner les vraies valeurs. Chargé automatiquement par
# scripts/dns-failover.sh à chaque lancement, survit à la fermeture du
# terminal.

# Créés sur https://www.ovh.com/auth/api/createToken avec les droits :
#   GET  /domain/zone/obrypoc.fr/record*
#   PUT  /domain/zone/obrypoc.fr/record*
#   POST /domain/zone/obrypoc.fr/refresh
OVH_APPLICATION_KEY="PASTE_HERE"
OVH_APPLICATION_SECRET="PASTE_HERE"
OVH_CONSUMER_KEY="PASTE_HERE"

# Sortie ingress_secondary_ip de infra/ingress/ (une fois
# ha-loadbalancer.tf appliqué) :
#   cd infra/ingress && SCW_PROFILE=newprofile terraform output -raw ingress_secondary_ip
SECONDARY_IP="PASTE_HERE"

pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  - name: promtool
                    image: prom/prometheus:latest
                    command: ["cat"]
                    tty: true
                    securityContext:
                      runAsUser: 1000
                  - name: deploy
                    image: alpine:3.20
                    command: ["cat"]
                    tty: true
                    securityContext:
                      capabilities:
                        add: ["NET_ADMIN"]
                    volumeMounts:
                    - name: wireguard-config
                      mountPath: /etc/wireguard-secret
                      readOnly: true
                    - name: ssh-key
                      mountPath: /root/.ssh-secret
                      readOnly: true
                  volumes:
                  - name: wireguard-config
                    secret:
                      secretName: deploy-wireguard
                  - name: ssh-key
                    secret:
                      secretName: deploy-ssh-key
                      defaultMode: 0400
            '''
        }
    }

    parameters {
        booleanParam(name: 'DEPLOY', defaultValue: false, description: 'Déployer sur demo-0 après validation des règles')
    }

    environment {
        DEMO_VM_IP = '192.168.1.5'
        ALERT_EMAIL = 'maxime.obry@ynov.com'
    }

    stages {
        stage('Lint des règles') {
            steps {
                container('promtool') {
                    dir('deploy/monitoring-stack') {
                        sh 'promtool check rules prometheus/alerts/*.yml'
                    }
                }
            }
        }

        stage('Tests unitaires des alertes') {
            steps {
                container('promtool') {
                    dir('deploy/monitoring-stack/unit-tests') {
                        sh 'promtool test rules *_test.yml'
                    }
                }
            }
        }

        stage('Déploiement') {
            when {
                expression { params.DEPLOY }
            }
            steps {
                container('deploy') {
                    sh 'apk add --no-cache wireguard-tools openssh-client rsync'

                    sh '''
                        mkdir -p /etc/wireguard
                        cp /etc/wireguard-secret/wg0.conf /etc/wireguard/wg0.conf
                        chmod 600 /etc/wireguard/wg0.conf
                        wg-quick up wg0

                        for i in $(seq 1 10); do
                            [ "$(wg show wg0 latest-handshakes | awk '{print $2}')" != "0" ] && break
                            sleep 1
                        done
                    '''

                    withCredentials([
                        string(credentialsId: 'proxmox-api-token', variable: 'PVE_TOKEN'),
                        usernamePassword(credentialsId: 'alerting-smtp', usernameVariable: 'SMTP_USER', passwordVariable: 'SMTP_PASS')
                    ]) {
                        sh '''
                            mkdir -p /root/.ssh
                            cp /root/.ssh-secret/id_ed25519 /root/.ssh/id_ed25519
                            chmod 600 /root/.ssh/id_ed25519

                            sed -i "s/__SMTP_USERNAME__/${SMTP_USER}/; s/__SMTP_PASSWORD__/${SMTP_PASS}/; s/__ALERT_EMAIL__/${ALERT_EMAIL}/" \
                                deploy/monitoring-stack/alertmanager/alertmanager.yml

                            PVE_USER="${PVE_TOKEN%%!*}"
                            REST="${PVE_TOKEN#*!}"
                            PVE_TOKEN_NAME="${REST%%=*}"
                            PVE_TOKEN_VALUE="${REST#*=}"

                            ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 admin@$DEMO_VM_IP "
                                sudo cloud-init status --wait >/dev/null 2>&1 || true &&
                                sudo apt-get update &&
                                sudo apt-get install -y docker.io docker-compose rsync &&
                                sudo systemctl disable --now prometheus-node-exporter 2>/dev/null || true &&
                                sudo mkdir -p /opt/monitoring-stack/pve-exporter &&
                                mkdir -p /tmp/monitoring-stack
                            "

                            rsync -e "ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519" -a --delete \
                                deploy/monitoring-stack/ admin@$DEMO_VM_IP:/tmp/monitoring-stack/

                            ssh -o StrictHostKeyChecking=no -i /root/.ssh/id_ed25519 admin@$DEMO_VM_IP "
                                sudo rsync -a --delete /tmp/monitoring-stack/ /opt/monitoring-stack/ &&
                                cat <<EOF | sudo tee /opt/monitoring-stack/pve-exporter/pve.yml > /dev/null
default:
  user: ${PVE_USER}
  token_name: ${PVE_TOKEN_NAME}
  token_value: ${PVE_TOKEN_VALUE}
  verify_ssl: false
EOF
                                cd /opt/monitoring-stack &&
                                sudo docker-compose up -d --force-recreate &&
                                sleep 5 &&
                                curl -s -X POST http://localhost:9090/-/reload &&
                                curl -s http://localhost:9090/-/healthy &&
                                curl -s http://localhost:9093/-/healthy
                            "
                        '''
                    }

                    sh 'wg-quick down wg0 || true'
                }
            }
        }
    }

    post {
        failure {
            echo 'Échec de la pipeline, aucun déploiement effectué.'
        }
    }
}

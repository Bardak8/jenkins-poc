pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  - name: terraform
                    image: hashicorp/terraform:1.15
                    command: ["cat"]
                    tty: true
                    envFrom:
                    - secretRef:
                        name: tfstate-credentials
            '''
            defaultContainer 'terraform'
        }
    }

    stages {
        stage('Terraform Init') {
            steps {
                dir('target-infra/vms/demo') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([string(credentialsId: 'proxmox-api-token', variable: 'PROXMOX_VE_API_TOKEN')]) {
                    dir('target-infra/vms/demo') {
                        script {
                            def targetIndex = (params.ROLE == 'app') ? params.TARGET.toInteger() : 0

                            def currentCount = sh(
                                script: "terraform state list | grep -c 'proxmox_virtual_environment_vm.demo\\[' || true",
                                returnStdout: true
                            ).trim().toInteger()

                            def newCount = Math.max(currentCount, targetIndex + 1)

                            def args = [
                                'terraform apply -auto-approve',
                                '-var="proxmox_endpoint=https://gateway.ci-cd.svc.cluster.local:8006"',
                                '-var="proxmox_node=ns536329"',
                                '-var="debian_template_id=9001"',
                                '-var="ssh_public_key=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIB9YhnWF0+Vu4vn71+kGoZPoDxlbnvMAQiFOjUBa1zgk maxime@maxime-Precision-5690"',
                                "-var=demo_vm_count=${newCount}",
                            ]

                            if (params.REPLACE) {
                                args << "-replace=proxmox_virtual_environment_vm.demo[${targetIndex}]"
                            }

                            sh args.join(' ')
                        }
                    }
                }
            }
        }
    }
}

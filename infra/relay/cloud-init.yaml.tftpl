#cloud-config
package_update: true
packages:
  - wireguard-tools
  - iptables
  - nginx

write_files:
  - path: /etc/wireguard/wg0.conf
    permissions: '0600'
    content: |
      [Interface]
      PrivateKey = ${relay_laptop_private_key}
      Address = 10.10.50.1/24
      ListenPort = 51820
      PostUp = iptables -A FORWARD -i wg0 -j ACCEPT ; iptables -A FORWARD -o wg0 -j ACCEPT
      PostDown = iptables -D FORWARD -i wg0 -j ACCEPT ; iptables -D FORWARD -o wg0 -j ACCEPT

      [Peer]
      PublicKey = ${laptop_wireguard_public_key}
      AllowedIPs = 10.10.50.2/32

  - path: /etc/wireguard/wg1.conf
    permissions: '0600'
    content: |
      [Interface]
      PrivateKey = ${relay_kapsule_private_key}
      Address = 10.10.40.1/24
      ListenPort = 51821
      PostUp = iptables -t nat -A POSTROUTING -o wg1 -j MASQUERADE
      PostDown = iptables -t nat -D POSTROUTING -o wg1 -j MASQUERADE

      [Peer]
      PublicKey = ${collab_gateway_wireguard_public_key}
      AllowedIPs = 10.10.40.2/32

  - path: /etc/wireguard/wg2.conf
    permissions: '0600'
    content: |
      [Interface]
      PrivateKey = ${relay_ovh_private_key}
      Address = 10.10.20.2/24
      PostUp = iptables -t nat -A POSTROUTING -o wg2 -j MASQUERADE
      PostDown = iptables -t nat -D POSTROUTING -o wg2 -j MASQUERADE

      [Peer]
      PublicKey = ${pfsense_wireguard_public_key}
      Endpoint = ${pfsense_collab_wan_endpoint}
      AllowedIPs = 192.168.1.0/24
      PersistentKeepalive = 25

  - path: /etc/sysctl.d/99-wireguard-forward.conf
    permissions: '0644'
    content: |
      net.ipv4.ip_forward = 1

  # Seul point public jamais exposé vers Jenkins : uniquement le chemin
  # webhook, protégé par le token dans l'URL (vérifié côté Jenkins).
  # Tout le reste (login, API, etc.) renvoie 403 sans jamais atteindre
  # Jenkins. Jenkins lui-même ne sort jamais de ClusterIP.
  - path: /etc/nginx/sites-available/webhook-relay
    permissions: '0644'
    content: |
      server {
        listen 8090;

        location /generic-webhook-trigger/ {
          proxy_pass http://10.10.40.2:8080;
          proxy_set_header Host jenkins.obrypoc.fr;
        }

        location / {
          return 403;
        }
      }

runcmd:
  - sysctl --system
  - systemctl enable --now wg-quick@wg0
  - systemctl enable --now wg-quick@wg1
  - systemctl enable --now wg-quick@wg2
  - rm -f /etc/nginx/sites-enabled/default
  - ln -sf /etc/nginx/sites-available/webhook-relay /etc/nginx/sites-enabled/webhook-relay
  - systemctl enable --now nginx
  - systemctl reload nginx

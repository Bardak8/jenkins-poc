{
  "title": "PoC - Stack monitoring demo-0",
  "uid": "poc-demo-0-stack",
  "tags": ["poc", "bloc5", "monitoring-blagnac"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "Demo-0 Prometheus",
        "query": "label_values(node_uname_info, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "service",
        "type": "query",
        "datasource": "Demo-0 Prometheus",
        "query": "label_values(probe_success, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Proxmox API (pve-exporter)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": "Demo-0 Prometheus",
      "targets": [
        { "expr": "pve_up", "legendFormat": "{{ id }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": null, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Sondes blackbox - $service",
      "type": "table",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "datasource": "Demo-0 Prometheus",
      "targets": [
        { "expr": "probe_success{service=~\"$service\"}", "legendFormat": "{{ job }} - {{ service }}", "format": "table", "instant": true }
      ]
    },
    {
      "id": 3,
      "title": "CPU utilisé (%) - $instance",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": "Demo-0 Prometheus",
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\", instance=\"$instance\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mémoire utilisée (%) - $instance",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": "Demo-0 Prometheus",
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=\"$instance\"} / node_memory_MemTotal_bytes{instance=\"$instance\"})) * 100",
          "legendFormat": "Mémoire %"
        }
      ]
    }
  ]
}

{
  "title": "Watchdog Prometheus",
  "uid": "poc-watchdog",
  "tags": ["poc", "bloc5", "watchdog"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Alerte WatchdogHeartbeatStale",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max(ALERTS{alertname=\"WatchdogHeartbeatStale\"}) or vector(0)",
          "legendFormat": "état"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "EN ALERTE", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Âge du dernier battement de coeur (s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "time() - jenkins_poc_watchdog_heartbeat_timestamp_seconds",
          "legendFormat": "âge (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 90, "color": "red" }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    }
  ]
}
